# 複製成 .env 後填入你自己的 Anthropic API key（Claude Max訂閱不含此額度，見docs/10）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 若上面是在console.anthropic.com新版介面建立的「身分連動(identity-linked)」key，
# 呼叫時需要額外指定是哪個workspace，否則會回400 anthropic-workspace-id required。
# 去 console.anthropic.com → Settings → Workspaces 找，通常是 wrkspc_ 開頭的字串。
# 若你的key不是這種類型（沒遇到這個錯誤），這行留空或刪掉即可。
ANTHROPIC_WORKSPACE_ID=

# 可選，預設 3001
PORT=3001

# 可選，預設 claude-sonnet-5；想切到更便宜的備案時改這裡即可（見docs/10）
INVOSNAP_VISION_MODEL=claude-sonnet-5
